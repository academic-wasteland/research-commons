Prefix(:=<https://w3id.org/research-commons/v0.1/>)
Prefix(ex:=<https://example.org/research-commons/contracts/public/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Ontology(<https://example.org/research-commons/contracts/public/ontology>
 Declaration(Class(:ResearchTask))
 Declaration(Class(:ResearchRequest))
 Declaration(Class(:ResearchContribution))
 Declaration(Class(:Actor))
 Declaration(Class(:Agent))
 Declaration(Class(:Dataset))
 Declaration(Class(:PublicDataset))
 Declaration(Class(:RestrictedDataset))
 Declaration(Class(:ResearchArtifact))
 Declaration(Class(ex:ProteinFunctionPredictionTask))
 Declaration(Class(ex:AcceptedPublicTask))
 Declaration(Class(ex:RejectedRestrictedTask))
 Declaration(Class(ex:PermissionRequiredTask))
 Declaration(Class(ex:ConformingContribution))
 Declaration(Class(ex:SinglyAccountableTask))
 Declaration(Class(ex:DelegatedExampleTask))
 Declaration(ObjectProperty(:requestedBy))
 Declaration(ObjectProperty(:producedBy))
 Declaration(ObjectProperty(:usesDataset))
 Declaration(ObjectProperty(:hasOutput))
 Declaration(ObjectProperty(:delegatesTo))
 Declaration(ObjectProperty(:actsUnderDelegation))
 Declaration(NamedIndividual(ex:principal))

 SubClassOf(ex:ProteinFunctionPredictionTask :ResearchTask)
 SubClassOf(:Agent :Actor)
 SubClassOf(:PublicDataset :Dataset)
 SubClassOf(:RestrictedDataset :Dataset)
 DisjointClasses(:PublicDataset :RestrictedDataset)
 EquivalentClasses(ex:AcceptedPublicTask ObjectIntersectionOf(:ResearchTask ObjectSomeValuesFrom(:requestedBy :Actor) ObjectSomeValuesFrom(:usesDataset :PublicDataset)))
 EquivalentClasses(ex:RejectedRestrictedTask ObjectIntersectionOf(:ResearchTask ObjectSomeValuesFrom(:usesDataset :RestrictedDataset)))
 EquivalentClasses(ex:PermissionRequiredTask ObjectIntersectionOf(:ResearchTask ObjectSomeValuesFrom(:usesDataset :RestrictedDataset)))
 EquivalentClasses(ex:ConformingContribution ObjectIntersectionOf(:ResearchContribution ObjectSomeValuesFrom(:producedBy :Agent) ObjectSomeValuesFrom(:hasOutput :ResearchArtifact)))
 EquivalentClasses(ex:SinglyAccountableTask ObjectIntersectionOf(:ResearchTask ObjectExactCardinality(1 :requestedBy :Actor)))
 ClassAssertion(:Actor ex:principal)
 SubObjectPropertyOf(ObjectPropertyChain(:requestedBy ObjectInverseOf(:delegatesTo)) :actsUnderDelegation)
 EquivalentClasses(ex:DelegatedExampleTask ObjectIntersectionOf(:ResearchTask ObjectHasValue(:actsUnderDelegation ex:principal)))
)
