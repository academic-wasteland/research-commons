{
  "@context": {
    "@version": 1.1,
    "rcp": "https://w3id.org/research-commons/v0.1/",
    "prov": "http://www.w3.org/ns/prov#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "ResearchRequest": "rcp:ResearchRequest",
    "ResearchTask": "rcp:ResearchTask",
    "ResearchContribution": "rcp:ResearchContribution",
    "Claim": "rcp:Claim",
    "Evidence": "rcp:Evidence",
    "Critique": "rcp:Critique",
    "ReplicationRequest": "rcp:ReplicationRequest",
    "ReplicationResult": "rcp:ReplicationResult",
    "Person": "rcp:Person",
    "Organization": "rcp:Organization",
    "Agent": "rcp:Agent",
    "PublicDataset": "rcp:PublicDataset",
    "RestrictedDataset": "rcp:RestrictedDataset",
    "ResearchArtifact": "rcp:ResearchArtifact",
    "partOfRequest": {"@id": "rcp:partOfRequest", "@type": "@id"},
    "requestedBy": {"@id": "rcp:requestedBy", "@type": "@id"},
    "onBehalfOf": {"@id": "rcp:onBehalfOf", "@type": "@id"},
    "producedBy": {"@id": "rcp:producedBy", "@type": "@id"},
    "addresses": {"@id": "rcp:addresses", "@type": "@id"},
    "usesDataset": {"@id": "rcp:usesDataset", "@type": "@id"},
    "hasOutput": {"@id": "rcp:hasOutput", "@type": "@id"},
    "hasClaim": {"@id": "rcp:hasClaim", "@type": "@id"},
    "hasEvidence": {"@id": "rcp:hasEvidence", "@type": "@id"},
    "supports": {"@id": "rcp:supports", "@type": "@id"},
    "contradicts": {"@id": "rcp:contradicts", "@type": "@id"},
    "replicates": {"@id": "rcp:replicates", "@type": "@id"},
    "critiques": {"@id": "rcp:critiques", "@type": "@id"},
    "semanticContract": {"@id": "rcp:semanticContract", "@type": "@id"},
    "ontologyProfile": {"@id": "rcp:ontologyProfile"},
    "taskType": {"@id": "rcp:taskType", "@type": "@id"},
    "semanticAssertions": "rcp:semanticAssertions",
    "assertionType": "rcp:assertionType",
    "individual": {"@id": "rcp:individual", "@type": "@id"},
    "class": {"@id": "rcp:class", "@type": "@id"},
    "property": {"@id": "rcp:property", "@type": "@id"},
    "question": "rcp:question",
    "statement": "rcp:statement",
    "subject": {"@id": "rcp:subject", "@type": "@id"},
    "predicate": {"@id": "rcp:predicate", "@type": "@id"},
    "object": "rcp:object",
    "generatedAtTime": {"@id": "prov:generatedAtTime", "@type": "xsd:dateTime"},
    "license": {"@id": "rcp:license", "@type": "@id"},
    "digest": "rcp:digest",
    "name": "rcp:name"
  }
}
