{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/research-commons/v0.1/agent-card-extension.schema.json",
  "title": "RCP A2A Agent Card extension parameters",
  "type": "object",
  "required": ["extension", "contracts"],
  "properties": {
    "extension": {"const": "https://w3id.org/research-commons/v0.1/a2a"},
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["manifest", "bundleDigest", "acceptedTaskClass", "guaranteedOutputClass"],
        "properties": {
          "manifest": {"type": "string", "format": "uri"},
          "bundleDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "acceptedTaskClass": {"type": "string", "format": "uri"},
          "guaranteedOutputClass": {"type": "string", "format": "uri"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
