@prefix rcp: <https://w3id.org/research-commons/v0.1/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .

rcp:ResearchTaskShape a sh:NodeShape ;
  sh:targetClass rcp:ResearchTask ;
  sh:property [ sh:path rcp:partOfRequest ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path rcp:requestedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path rcp:semanticContract ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path rcp:ontologyProfile ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

rcp:ResearchContributionShape a sh:NodeShape ;
  sh:targetClass rcp:ResearchContribution ;
  sh:property [ sh:path rcp:addresses ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path rcp:producedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path rcp:hasOutput ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path rcp:semanticContract ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path rcp:ontologyProfile ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

rcp:ClaimShape a sh:NodeShape ;
  sh:targetClass rcp:Claim ;
  sh:property [ sh:path rcp:statement ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path rcp:subject ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path rcp:predicate ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path rcp:object ; sh:minCount 1 ; sh:maxCount 1 ] .

rcp:MetadataDescriptorShape a sh:NodeShape ;
  sh:targetClass schema:CreativeWork ;
  sh:property [
    sh:path schema:about ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node rcp:RootDataEntityShape ;
  ] .

rcp:RootDataEntityShape a sh:NodeShape ;
  sh:class schema:Dataset ;
  sh:property [
    sh:path schema:hasPart ;
    sh:qualifiedValueShape [
      sh:nodeKind sh:IRI ;
      sh:property [
        sh:path schema:encodingFormat ;
        sh:hasValue "application/ld+json" ;
        sh:minCount 1 ;
      ] ;
      sh:property [
        sh:path rcp:digest ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
      ] ;
      sh:property [
        sh:path [ sh:inversePath [ sh:alternativePath ( schema:object schema:result ) ] ] ;
        sh:class schema:CreateAction ;
        sh:minCount 1 ;
      ] ;
    ] ;
    sh:qualifiedMinCount 1 ;
    sh:message "RO-Crate Root Data Entity must explicitly link to parts including the carried RCP JSON-LD file." ;
  ] .

rcp:CreateActionCarrierShape a sh:NodeShape ;
  sh:targetClass schema:CreateAction ;
  sh:property [
    sh:path [ sh:alternativePath ( schema:object schema:result ) ] ;
    sh:minCount 1 ;
    sh:message "CreateAction must explicitly link to the carried RCP JSON-LD file." ;
  ] ;
  sh:property [
    sh:path rcp:digest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^sha256:[0-9a-f]{64}$" ;
    sh:message "CreateAction must contain a valid canonical sha256 digest string." ;
  ] .
