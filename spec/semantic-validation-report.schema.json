{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/research-commons/v0.1/semantic-validation-report.schema.json",
  "title": "Semantic validation report",
  "type": "object",
  "required": ["status", "message", "contract", "bundleDigest", "checker", "checks"],
  "properties": {
    "status": {"enum": ["entailed", "contradicted", "unknown", "invalid", "indeterminate"]},
    "message": {"type": "string", "format": "uri"},
    "contract": {"type": "string", "format": "uri"},
    "bundleDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "checker": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {"name": {"type": "string"}, "version": {"type": "string"}},
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "status", "durationMs"],
        "properties": {
          "kind": {"type": "string"},
          "status": {"enum": ["entailed", "contradicted", "unknown", "invalid", "indeterminate"]},
          "durationMs": {"type": "integer", "minimum": 0},
          "diagnostic": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
