Prefix(:=<https://w3id.org/research-commons/v0.1/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Ontology(<https://w3id.org/research-commons/v0.1/ontology>
 Declaration(Class(:Message))
 Declaration(Class(:ResearchRequest))
 Declaration(Class(:ResearchTask))
 Declaration(Class(:ResearchContribution))
 Declaration(Class(:Claim))
 Declaration(Class(:Evidence))
 Declaration(Class(:Critique))
 Declaration(Class(:ReplicationRequest))
 Declaration(Class(:ReplicationResult))
 Declaration(Class(:Actor))
 Declaration(Class(:Person))
 Declaration(Class(:Organization))
 Declaration(Class(:Agent))
 Declaration(Class(:Dataset))
 Declaration(Class(:PublicDataset))
 Declaration(Class(:RestrictedDataset))
 Declaration(Class(:ResearchArtifact))
 Declaration(Class(:Capability))
 Declaration(Class(:SemanticValidationReport))

 Declaration(ObjectProperty(:partOfRequest))
 Declaration(ObjectProperty(:requestedBy))
 Declaration(ObjectProperty(:onBehalfOf))
 Declaration(ObjectProperty(:producedBy))
 Declaration(ObjectProperty(:addresses))
 Declaration(ObjectProperty(:usesDataset))
 Declaration(ObjectProperty(:hasOutput))
 Declaration(ObjectProperty(:hasClaim))
 Declaration(ObjectProperty(:hasEvidence))
 Declaration(ObjectProperty(:supports))
 Declaration(ObjectProperty(:contradicts))
 Declaration(ObjectProperty(:replicates))
 Declaration(ObjectProperty(:critiques))
 Declaration(ObjectProperty(:delegatesTo))
 Declaration(ObjectProperty(:authorizes))
 Declaration(ObjectProperty(:effectiveAuthorization))

 SubClassOf(:ResearchRequest :Message)
 SubClassOf(:ResearchTask :Message)
 SubClassOf(:ResearchContribution :Message)
 SubClassOf(:Critique :ResearchContribution)
 SubClassOf(:ReplicationRequest :ResearchTask)
 SubClassOf(:ReplicationResult :ResearchContribution)
 SubClassOf(:Person :Actor)
 SubClassOf(:Organization :Actor)
 SubClassOf(:Agent :Actor)
 SubClassOf(:PublicDataset :Dataset)
 SubClassOf(:RestrictedDataset :Dataset)
 DisjointClasses(:Message :Actor)
 DisjointClasses(:PublicDataset :RestrictedDataset)

 ObjectPropertyDomain(:requestedBy :ResearchTask)
 ObjectPropertyRange(:requestedBy :Actor)
 ObjectPropertyDomain(:producedBy :ResearchContribution)
 ObjectPropertyRange(:producedBy :Actor)
 ObjectPropertyDomain(:usesDataset :ResearchTask)
 ObjectPropertyRange(:usesDataset :Dataset)
 ObjectPropertyDomain(:hasOutput :ResearchContribution)
 ObjectPropertyRange(:hasOutput :ResearchArtifact)
 SubObjectPropertyOf(ObjectPropertyChain(ObjectInverseOf(:delegatesTo) :authorizes) :effectiveAuthorization)
)
